#include "vendor/outer_impl.h"
#include "params/fft_c2c_large_tiling.h"

#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif

extern "C" __global__ __vector__ void fft_c2c_outer(
    __gm__ float* input, __gm__ float* twiddles, __gm__ float* cross,
    __gm__ float* output, __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    const auto* t = reinterpret_cast<__gm__ FftC2CLargeTilingData*>(tiling);
    const int qLog2 = __builtin_ctz(static_cast<unsigned>(t->q));
    const int colLog2 = __builtin_ctz(static_cast<unsigned>(t->columns));
    if constexpr (TILING_KEY_IS(3)) {
        RunOuterRegister(input, twiddles, cross, output, t->batch, qLog2, colLog2);
    } else if constexpr (TILING_KEY_IS(4)) {
        RunOuterSimd(input, twiddles, cross, output, t->batch, qLog2, colLog2);
    } else if constexpr (TILING_KEY_IS(5)) {
        AscendC::InitSocState();
        OuterOptimized<true, true>(input, twiddles, cross, output, t->batch, 5, colLog2);
        AscendC::PipeBarrier<PIPE_ALL>();
    } else if constexpr (TILING_KEY_IS(6)) {
        AscendC::InitSocState();
        OuterOptimized<true, false, true>(input, twiddles, cross, output, t->batch, 6, colLog2);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
