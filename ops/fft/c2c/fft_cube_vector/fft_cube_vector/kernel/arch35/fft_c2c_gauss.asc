#include "vendor/gauss32_impl.h"
#include "params/fft_c2c_large_tiling.h"

extern "C" __global__ __mix__(1,2) void fft_c2c_gauss(
    __gm__ float* input, __gm__ float* coeff, __gm__ float* unused,
    __gm__ float* output, __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftC2CLargeTilingData*>(tiling);
    const int rows = static_cast<int>(t->batch * t->q * 128);
    const int outputLog2 = 7 + __builtin_ctz(static_cast<unsigned>(t->q));
    if ASCEND_IS_AIC { GaussCube(coeff, rows); }
    if ASCEND_IS_AIV { GaussVector<true>(input, coeff, output, rows, t->inverse != 0, outputLog2); }
    AscendC::PipeBarrier<PIPE_ALL>();
}
