#include "vendor/regbase_common.h"
#include "vendor/extended_vector.h"
#include "params/fft_c2c_large_tiling.h"

extern "C" __global__ __vector__ void fft_c2c_cube_vector_b(
    __gm__ float* input, __gm__ float* twiddles, __gm__ float* unused,
    __gm__ float* output, __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftC2CLargeTilingData*>(tiling);
    RunPhaseBExtended(input, twiddles, output, t->batch * t->q * 8, t->q * 128);
    AscendC::PipeBarrier<PIPE_ALL>();
}
