#include "regbase_large_impl.h"

#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif

extern "C" __global__ __vector__ void fft_c2c_regbase_large_b(
    __gm__ float* input, __gm__ float* twiddles, __gm__ float* unused,
    __gm__ float* output, __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftC2CRegBaseLargeTilingData*>(tiling);
    if constexpr (TILING_KEY_IS(16384)) {
        RunPhaseBDoubleBufferedPhysicalTwiddle(input, twiddles, output, LoadTaskCount<16>(tiling));
    } else if constexpr (TILING_KEY_IS(32768)) {
        RunPhaseBDoubleBufferedPhysicalTwiddle<256, 4>(input, twiddles, output, t->batch * 32);
    } else if constexpr (TILING_KEY_IS(65536)) {
        RunPhaseBDoubleBufferedPhysicalTwiddle<256, 4, 256>(input, twiddles, output, t->batch * 64);
    } else if constexpr (TILING_KEY_IS(131072)) {
        RunPhaseBDoubleBufferedPhysicalTwiddle<512, 4, 256>(input, twiddles, output, t->batch * 64);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}
