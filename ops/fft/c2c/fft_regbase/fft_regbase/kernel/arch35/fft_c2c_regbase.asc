#include "fft_regbase_impl.h"

#ifndef TILING_KEY_VAR
#error "MKI must compile each RegBase specialization with TILING_KEY_VAR"
#endif
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif

// MKI ABI: two inputs, one output, unused workspace, and 16-byte tiling.
extern "C" __global__ __vector__ void fft_c2c_regbase(
    __gm__ float *input, __gm__ float *coeff, __gm__ float *output,
    __gm__ uint8_t *workspace, __gm__ uint8_t *tiling)
{
    (void)workspace;
    if constexpr (TILING_KEY_IS(256)) {
        RunRegBase<128, 256, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(257)) {
        RunRegBase<128, 256, true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(512)) {
        RunRegBase<256, 256, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(513)) {
        RunRegBase<256, 256, true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(1024)) {
        RunRegBase<512, 1024, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(1025)) {
        RunRegBase<512, 1024, true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2048)) {
        RunRegBase<1024, 1024, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(2049)) {
        RunRegBase<1024, 1024, true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(4096)) {
        RunRegBase<2048, 2048, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(4097)) {
        RunRegBase<2048, 2048, true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(8192)) {
        RunRegBase<4096, 4096, false>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(8193)) {
        RunRegBase<4096, 4096, true>(input, coeff, output, tiling);
    }
    if constexpr (TILING_KEY_IS(16384)) {
        RunRegBase<8192, 8192, false>(input, coeff, output, tiling);
    }
}
