#include "vendor/regbase_real_boundary_impl.h"
#include "params/fft_real_regbase_tiling.h"
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif
extern "C" __global__ __vector__ void fft_real_regbase_boundary(
    __gm__ float* input, __gm__ float* coreTw, __gm__ float* realTw, __gm__ float* output,
    __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftRealRegBaseTiling*>(tiling);
    if constexpr (TILING_KEY_IS(512)) RunBoundary<false, 256>(input, realTw, output, t->realN, t->batch);
    if constexpr (TILING_KEY_IS(513)) RunBoundary<true, 256>(input, realTw, output, t->realN, t->batch);
    if constexpr (TILING_KEY_IS(2048)) RunBoundary<false, 1024>(input, realTw, output, t->realN, t->batch);
    if constexpr (TILING_KEY_IS(2049)) RunBoundary<true, 1024>(input, realTw, output, t->realN, t->batch);
    if constexpr (TILING_KEY_IS(8192)) RunBoundary<false, 4096>(input, realTw, output, t->realN, t->batch);
    if constexpr (TILING_KEY_IS(8193)) RunBoundary<true, 4096>(input, realTw, output, t->realN, t->batch);
    AscendC::PipeBarrier<PIPE_ALL>();
}
