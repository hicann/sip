    if constexpr (TILING_KEY_IS(65536)) real_fused::Run<4096, false, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(65537)) real_fused::Run<4096, false, false, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(65540)) real_fused::Run<4096, false, false, true, false>(input, coreTw, realTw, output, t->batch);
