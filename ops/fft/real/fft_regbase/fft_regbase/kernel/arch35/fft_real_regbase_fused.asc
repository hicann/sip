#include "vendor/regbase_small_impl.h"
#include "vendor/regbase_real_fused_impl.h"
#include "params/fft_real_regbase_tiling.h"
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif
extern "C" __global__ __vector__ void fft_real_regbase_fused(
    __gm__ float* input, __gm__ float* coreTw, __gm__ float* realTw, __gm__ float* output,
    __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftRealRegBaseTiling*>(tiling);
    if constexpr (TILING_KEY_IS(2048)) real_fused::Run<128, false, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2049)) real_fused::Run<128, false, false, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2056)) real_fused::Run<128, true, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(2057)) real_fused::Run<128, true, false, false, true>(input, coreTw, realTw, output, t->batch);
