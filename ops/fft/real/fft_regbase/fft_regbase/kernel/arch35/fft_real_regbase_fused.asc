    if constexpr (TILING_KEY_IS(65545)) real_fused::Run<4096, true, false, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(65548)) real_fused::Run<4096, true, false, true, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(65549)) real_fused::Run<4096, true, false, true, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(131072)) real_fused::Run<8192, false, false, false, false>(input, coreTw, realTw, output, t->batch);
