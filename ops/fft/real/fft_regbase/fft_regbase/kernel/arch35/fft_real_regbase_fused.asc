    if constexpr (TILING_KEY_IS(131081)) real_fused::Run<8192, true, false, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(131084)) real_fused::Run<8192, true, false, true, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(131085)) real_fused::Run<8192, true, false, true, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(262144)) real_fused::Run<16384, false, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(262148)) real_fused::Run<16384, false, false, true, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(262152)) real_fused::Run<16384, true, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(262156)) real_fused::Run<16384, true, false, true, false>(input, coreTw, realTw, output, t->batch);
    AscendC::PipeBarrier<PIPE_ALL>();
}
