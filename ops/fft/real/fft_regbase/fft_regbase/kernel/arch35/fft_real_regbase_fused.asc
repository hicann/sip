    if constexpr (TILING_KEY_IS(8202)) real_fused::Run<512, true, true, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(8203)) real_fused::Run<512, true, true, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(16384)) real_fused::Run<1024, false, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(16385)) real_fused::Run<1024, false, false, false, true>(input, coreTw, realTw, output, t->batch);
