    if constexpr (TILING_KEY_IS(4106)) real_fused::Run<256, true, true, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(4107)) real_fused::Run<256, true, true, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(8192)) real_fused::Run<512, false, false, false, false>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(8193)) real_fused::Run<512, false, false, false, true>(input, coreTw, realTw, output, t->batch);
    if constexpr (TILING_KEY_IS(8194)) real_fused::Run<512, false, true, false, false>(input, coreTw, realTw, output, t->batch);
