#include "vendor/regbase_small_impl.h"
#include "params/fft_real_regbase_tiling.h"
#ifndef TILING_KEY_IS
#define TILING_KEY_IS(key) (TILING_KEY_VAR == (key))
#endif
extern "C" __global__ __vector__ void fft_real_regbase_small(
    __gm__ float* input, __gm__ float* coreTw, __gm__ float* realTw, __gm__ float* output,
    __gm__ uint8_t* workspace, __gm__ uint8_t* tiling)
{
    AscendC::InitSocState();
    const auto* t = reinterpret_cast<__gm__ FftRealRegBaseTiling*>(tiling);
    if constexpr (TILING_KEY_IS(530)) RunDoubleBufferedDirectPrefetch<8, 256, FftC2CRegBaseSmallVariant::FusedUnrolledPackedDirectDoubleBuffer, false>(input, coreTw, output, LoadBatch<8, 256>(tiling));
    if constexpr (TILING_KEY_IS(1042)) RunDoubleBufferedDirectPrefetch<16, 256, FftC2CRegBaseSmallVariant::FusedUnrolledPackedDirectDoubleBuffer, false>(input, coreTw, output, LoadBatch<16, 256>(tiling));
    if constexpr (TILING_KEY_IS(1046)) RunDoubleBufferedDirectPrefetch<16, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirectDoubleBuffer, false>(input, coreTw, output, LoadBatch<16, 256>(tiling));
    if constexpr (TILING_KEY_IS(2066)) RunDoubleBufferedDirectPrefetch<32, 256, FftC2CRegBaseSmallVariant::FusedUnrolledPackedDirectDoubleBuffer, false>(input, coreTw, output, LoadBatch<32, 256>(tiling));
    if constexpr (TILING_KEY_IS(2068)) RunSingleBuffered<32, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirect, false>(input, coreTw, output, LoadBatch<32, 256>(tiling));
    if constexpr (TILING_KEY_IS(2070)) RunDoubleBufferedDirectPrefetch<32, 256, FftC2CRegBaseSmallVariant::FusedRegisterDirectDoubleBuffer, false>(input, coreTw, output, LoadBatch<32, 256>(tiling));
    if constexpr (TILING_KEY_IS(524320)) RunSingleBuffered<8192, 8192, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, false>(input, coreTw, output, LoadBatch<8192, 8192>(tiling));
    if constexpr (TILING_KEY_IS(524321)) RunSingleBuffered<8192, 8192, FftC2CRegBaseSmallVariant::FusedRadix4UnrolledDirect, true>(input, coreTw, output, LoadBatch<8192, 8192>(tiling));
    AscendC::PipeBarrier<PIPE_ALL>();
}
